# ==============================================================================
# Presco — configuração de deploy (cópia para deploy/.env.deploy)
#
#   cp deploy/.env.deploy.example deploy/.env.deploy && $EDITOR deploy/.env.deploy
#
# deploy/.env.deploy está no .gitignore e NUNCA deve ser commitado.
# Os mesmos nomes são usados como GitHub Actions Secrets em .github/workflows/deploy.yml.
# ==============================================================================

# --- Acesso SSH ao servidor -------------------------------------------------
SSH_HOST=servidor.exemplo.com
SSH_USER=usuario
SSH_PORT=22
# Chave privada específica para deploy (opcional; senão usa o ~/.ssh/config)
# SSH_KEY_FILE=~/.ssh/id_deploy_presco
REMOTE_TARGET_DIR=/var/www/equipes/projeto

# --- Runtime do backend no servidor ----------------------------------------
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/banco
REDIS_URL=rediss://default:token@host.upstash.io:6379
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-hex
SERVER_PORT=3333
NODE_ENV=production
HERE_API_KEY=
# ALLOWED_ORIGINS=https://app.exemplo.com,https://outro.exemplo.com

# --- URL pública (healthcheck e proxy) --------------------------------------
PUBLIC_URL=https://exemplo.com/projeto
REWRITE_BASE=/projeto/
