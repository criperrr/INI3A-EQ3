# ==============================================================================
# Presco Frontend - Environment Configuration Template
# ==============================================================================
# Escolha a URL do backend de acordo com seu ambiente de teste:

# [Opção 1 - Recomendada] Servidor Remoto Oficial (CTI)
# Funciona diretamente de qualquer celular, emulador ou navegador sem necessidade de túnel ou mesma rede Wi-Fi.
EXPO_PUBLIC_API_URL=https://eq.projetoscti.com.br/26-presco

# [Opção 2] Rede Local Wi-Fi (LAN)
# Conexão direta de ultra-baixa latência no mesmo roteador/hotspot.
# EXPO_PUBLIC_API_URL=http://192.168.0.100:3333

# [Opção 3] Localhost
# Indicado apenas para Simulador iOS, Emulador Android ou Navegador Web no mesmo computador.
# EXPO_PUBLIC_API_URL=http://localhost:3333

# Chave opcional de mapas da HERE
EXPO_PUBLIC_HERE_API_KEY=

# Chave do Google Maps para Android (react-native-maps).
# Sem ela o mapa aparece cinza no APK compilado. Crie em console.cloud.google.com,
# habilite "Maps SDK for Android" e restrinja por pacote com.presco.app + SHA-1.
GOOGLE_MAPS_API_KEY=
