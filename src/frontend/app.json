{
  "expo": {
    "name": "Presco",
    "slug": "presco",
    "version": "1.0.7",
    "orientation": "portrait",
    "scheme": "presco",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.presco.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.presco.app",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 8
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Presco precisa da sua localização para encontrar mercados próximos a você.",
          "locationWhenInUsePermission": "O Presco precisa da sua localização para encontrar mercados próximos a você.",
          "locationAlwaysPermission": "O Presco precisa da sua localização para encontrar mercados próximos a você."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Presco precisa de acesso à câmera para escanear códigos de barras de produtos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/icon.png",
    "owner": "presco.tcc.projetoscti",
    "extra": {
      "eas": {
        "projectId": "83e64f4c-dc9b-4531-9963-18ad4da776db"
      }
    }
  }
}
