# PostgreSQL Connection String (with PostGIS enabled)
# Format: postgres://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/presco_db

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# Express Server Port and Host
SERVER_PORT=3333
SERVER_HOST=0.0.0.0

# JWT Secret Key for Access & Refresh Token Signing
JWT_SECRET=super_secret_jwt_presco_key_2026_dev_ini3a
