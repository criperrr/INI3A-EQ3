{
  "name": "ini3a-eq3",
  "version": "1.0.0",
  "scripts": {
    "dev": "bash ./start_project.sh",
    "dev:local": "bash ./start_project.sh --local-nat",
    "dev:nat": "bash ./start_project.sh --local-nat",
    "dev:tunnel": "bash ./start_project.sh --tunnel",
    "dev:win": "powershell -ExecutionPolicy Bypass -NoProfile -File ./start_project.ps1",
    "dev:win:local": "powershell -ExecutionPolicy Bypass -NoProfile -File ./start_project.ps1 -LocalNat",
    "dev:win:separate": "powershell -ExecutionPolicy Bypass -NoProfile -File ./start_project.ps1 -LocalNat -SeparateWindows",
    "db:reload": "bash ./reload_services.sh",
    "db:restart": "bash ./reload_services.sh --restart",
    "db:status": "bash ./reload_services.sh --status",
    "db:check": "npm run --prefix src/backend db:check",
    "install:all": "npm install && npm install --prefix src/backend && npm install --prefix src/frontend",
    "install:clean": "npm run install:win:clean",
    "install:win": "cmd /c install_dependencies.bat",
    "install:win:clean": "cmd /c install_dependencies.bat --clean"
  },
  "dependencies": {
    "ngrok": "^5.0.0-beta.2"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
