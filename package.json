{
  "name": "presco",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "dev": "tsx scripts/dev_launcher.ts",
    "dev:local": "tsx scripts/dev_launcher.ts --lan",
    "dev:lan": "tsx scripts/dev_launcher.ts --lan",
    "dev:corp": "tsx scripts/dev_launcher.ts --corp",
    "dev:tunnel": "tsx scripts/dev_launcher.ts --corp",
    "dev:localhost": "tsx scripts/dev_launcher.ts --localhost",
    "dev:turbo": "turbo run dev",
    "dev:check": "tsx scripts/verify_connection.ts",
    "android": "tsx scripts/android.ts",
    "ios": "npm run --prefix src/frontend ios",
    "prebuild": "npm run --prefix src/frontend prebuild",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f",
    "db:seed": "turbo run db:seed --filter=backend",
    "db:migrate": "turbo run db:migrate --filter=backend",
    "db:check": "turbo run db:check --filter=backend",
    "install:all": "npm install",
    "deploy": "bash scripts/deploy_remote.sh",
    "env": "tsx scripts/configure_env.ts",
    "env:remote": "tsx scripts/configure_env.ts remote",
    "env:local": "tsx scripts/configure_env.ts local",
    "env:localhost": "tsx scripts/configure_env.ts localhost",
    "remote:status": "bash scripts/remote.sh status",
    "remote:logs": "bash scripts/remote.sh logs",
    "remote:logs:stream": "bash scripts/remote.sh logs:stream",
    "remote:restart": "bash scripts/remote.sh restart",
    "remote:crashlog": "bash scripts/remote.sh crashlog",
    "deploy:only": "bash scripts/deploy_remote.sh --no-sync",
    "remote:shell": "bash scripts/remote.sh shell",
    "android:debug": "tsx scripts/android.ts --debug",
    "android:apk": "tsx scripts/android.ts --no-install",
    "doctor:jdk": "tsx scripts/lib/jdk.ts --install",
    "release": "tsx scripts/upload_release.ts"
  },
  "devDependencies": {
    "@types/localtunnel": "^2.0.4",
    "localtunnel": "^2.0.2",
    "turbo": "^2.5.4"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10"
  }
}