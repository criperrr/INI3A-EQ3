{
  "name": "presco",
  "version": "1.4.3",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "dev": "tsx scripts/dev_launcher.ts",
    "dev:local": "tsx scripts/dev_launcher.ts --lan",
    "dev:lan": "tsx scripts/dev_launcher.ts --lan",
    "dev:corp": "tsx scripts/dev_launcher.ts --corp",
    "dev:tunnel": "tsx scripts/dev_launcher.ts --corp",
    "dev:localhost": "tsx scripts/dev_launcher.ts --localhost",
    "dev:turbo": "turbo run dev",
    "dev:check": "tsx scripts/verify_connection.ts",
    "android": "tsx scripts/android.ts",
    "ios": "npm run --prefix src/frontend ios",
    "prebuild": "npm run --prefix src/frontend prebuild",
    "build": "turbo run build",
    "lint": "npm run --prefix src/frontend lint",
    "typecheck": "npm run --prefix src/backend typecheck && npm run --prefix src/frontend typecheck",
    "test": "npm run --prefix src/backend test && tsx --test tests/*.test.ts tests/concurrency/*.test.ts",
    "test:backend": "npm run --prefix src/backend test",
    "test:concurrency": "tsx --test tests/concurrency/*.test.ts",
    "test:k6": "k6 run tests/k6/main.js",
    "test:k6:journeys": "k6 run tests/k6/user_journeys/anonymous_browser.js && k6 run tests/k6/user_journeys/active_collaborator.js",
    "test:k6:stress": "k6 run tests/k6/stress_and_soak/stress_test.js",
    "test:k6:spike": "k6 run tests/k6/stress_and_soak/spike_test.js",
    "test:maestro": "docker compose run --rm maestro",
    "test:maestro:full": "docker compose run --rm maestro test tests/maestro/flows/11_full_app_stability_suite.yaml",
    "test:maestro:all": "docker compose run --rm maestro test tests/maestro/flows",
    "version:bump": "tsx scripts/bump_version.ts patch",
    "version:bump:minor": "tsx scripts/bump_version.ts minor",
    "version:bump:major": "tsx scripts/bump_version.ts major",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f",
    "db:seed": "turbo run db:seed --filter=backend",
    "db:migrate": "turbo run db:migrate --filter=backend",
    "db:check": "turbo run db:check --filter=backend",
    "install:all": "npm install",
    "deploy": "bash scripts/deploy_remote.sh",
    "env": "tsx scripts/configure_env.ts",
    "env:dev": "tsx scripts/configure_env.ts dev",
    "env:prod": "tsx scripts/configure_env.ts prod",
    "env:remote": "tsx scripts/configure_env.ts remote",
    "env:local": "tsx scripts/configure_env.ts local",
    "env:localhost": "tsx scripts/configure_env.ts localhost",
    "remote:status": "bash scripts/remote.sh status",
    "remote:logs": "bash scripts/remote.sh logs",
    "remote:logs:stream": "bash scripts/remote.sh logs:stream",
    "remote:restart": "bash scripts/remote.sh restart",
    "remote:crashlog": "bash scripts/remote.sh crashlog",
    "deploy:only": "bash scripts/deploy_remote.sh --no-sync",
    "remote:shell": "bash scripts/remote.sh shell",
    "android:debug": "tsx scripts/android.ts --debug",
    "android:dev": "APP_VARIANT=development tsx scripts/android.ts --debug",
    "android:prod": "APP_VARIANT=production tsx scripts/android.ts --no-install",
    "android:apk": "tsx scripts/android.ts --no-install",
    "doctor:jdk": "tsx scripts/lib/jdk.ts --install",
    "release": "tsx scripts/upload_release.ts"
  },
  "devDependencies": {
    "@types/localtunnel": "^2.0.4",
    "localtunnel": "^2.0.2",
    "turbo": "^2.5.4"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "expo-modules-core": "57.0.16",
    "expo-modules-jsi": "57.0.8"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10"
  }
}
